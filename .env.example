# Environment Configuration for Power Studio

# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Audio Configuration
AUDIO_SAMPLE_RATE=44100
AUDIO_BIT_DEPTH=24
AUDIO_CHANNELS=2
MAX_FILE_SIZE=500MB
FFMPEG_PATH=/usr/bin/ffmpeg

# Music Theory Defaults
DEFAULT_KEY=C
DEFAULT_TEMPO=120
DEFAULT_TIME_SIGNATURE=4/4
DEFAULT_SCALE=major

# AI Engines - API Keys
OPENAI_API_KEY=sk_your_key_here
ANTHROPIC_API_KEY=sk_ant_your_key_here
GOOGLE_CLOUD_API_KEY=your_key_here
ESSENTIA_API_KEY=your_key_here

# Streaming Services
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
YOUTUBE_API_KEY=your_api_key

# Output Format Support
SUPPORT_FL_STUDIO_DWP=true
SUPPORT_WAV=true
SUPPORT_MIDI=true
SUPPORT_MP3=true

# Database Configuration (for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=power_studio
DB_USER=postgres
DB_PASSWORD=password

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Session Configuration
SESSION_SECRET=your_secret_key_here_change_in_production
SESSION_TIMEOUT=3600000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_RETRIES=3

# Performance Tuning
WORKER_THREADS=4
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30000
