{
  "name": "Power Studio",
  "version": "1.0.0",
  "description": "Advanced AI Music Production Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:client": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "start": "node src/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "music",
    "production",
    "ai",
    "chord-extraction",
    "chord-generation",
    "daw",
    "fl-studio",
    "midi",
    "audio-processing",
    "music-theory",
    "machine-learning",
    "generative-ai"
  ],
  "author": "amoncarver666",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amoncarver666/power-studio.git"
  },
  "bugs": {
    "url": "https://github.com/amoncarver666/power-studio/issues"
  },
  "homepage": "https://github.com/amoncarver666/power-studio#readme",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tone": "^14.8.49",
    "wavefile": "^12.0.0",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.1.1",
    "vite": "^5.0.0",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "eslint": "^8.52.0",
    "eslint-config-react-app": "^7.0.1",
    "prettier": "^3.0.3",
    "concurrently": "^8.2.1",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
